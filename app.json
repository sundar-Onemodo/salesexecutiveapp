{
  "expo": {
    "name": "OnemodoPatrons",
    "slug": "onemodopatrons",
    "owner": "sayee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "onemodopatrons",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app_icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#9C040B",
        "foregroundImage": "./assets/images/app_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.onemodo.patrons"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#9C040B",
          "image": "./assets/images/transparent-splash.png",
          "imageWidth": 1
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/cd6fd10b-64d6-4356-81a4-6deda8923429"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd6fd10b-64d6-4356-81a4-6deda8923429"
      }
    }
  }
}
